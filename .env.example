# Convex Configuration (Auto-generated)
# These are automatically generated when you run `bun run dev` for the first time.
# Convex CLI will prompt you to create a project and add these values.
# You can leave these as placeholders - they will be filled in automatically.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Encryption Secret (Manual - Required)
# Generate with: openssl rand -base64 32
# IMPORTANT: This same value must also be set in Convex Dashboard
# Set this value before running `bun run dev` for the first time
ENCRYPTION_SECRET=your-encryption-secret-min-32-chars

# Push Notifications (Optional - for PWA push notifications)
# Generate VAPID keys with: npx web-push generate-vapid-keys
# Or use an online generator: https://web-push-codelab.glitch.me/
# The public key is safe to expose (used in client code)
# The private key must be kept secret (only used server-side)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT_EMAIL=mailto:your-email@example.com
