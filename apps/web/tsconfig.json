{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@/convex/*": ["../../packages/backend/convex/*"],
      "validators": ["../../packages/validators/index.ts"],
      "validators/*": ["../../packages/validators/src/*"],
      "encryption": ["../../packages/encryption/index.ts"],
      "encryption/*": ["../../packages/encryption/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".vinxi", ".output"]
}
