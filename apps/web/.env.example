# Next.js Environment Variables
# Copy this file to apps/web/.env.local and fill in your values

# ============================================
# Convex Configuration (Auto-generated)
# ============================================
# These variables are automatically generated when you run `bun run dev` for the first time.
# Convex CLI will prompt you to create a project and add these values.
# 
# Note: CONVEX_DEPLOYMENT is also written to packages/backend/.env.local by Convex CLI
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ============================================
# Encryption Secret (Required)
# ============================================
# Used for encrypting API keys stored in Convex
# Generate with: openssl rand -base64 32
# 
# IMPORTANT: This same value must also be set in your Convex Dashboard
# (Settings → Environment Variables → ENCRYPTION_SECRET)
ENCRYPTION_SECRET=your-encryption-secret-min-32-chars

# ============================================
# Optional: Vercel Deployment Variables
# ============================================
# Only needed if deploying to Vercel
# CONVEX_SITE_URL=https://your-deployment.convex.site
# CONVEX_DEPLOY_KEY=prod:example.com

# ============================================
# Convex Dashboard Environment Variables
# ============================================
# The following variables are set in the Convex Dashboard (Settings → Environment Variables),
# NOT in this .env.local file. They are used by Convex functions running in the cloud:
#
# - SITE_URL: Your app URL (e.g., http://localhost:3000 for dev, https://your-app.com for production)
# - ENCRYPTION_SECRET: Same value as above (must match your local .env.local)
# - CURSOR_WEBHOOK_URL: Your Convex webhook endpoint (e.g., https://your-deployment.convex.site/webhooks/cursor)
# - CURSOR_WEBHOOK_SECRET: Secret for webhook signature verification (generate with: openssl rand -hex 32)
